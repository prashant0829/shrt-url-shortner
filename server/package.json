{
  "name": "url-shortener-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API and click worker for the URL shortener.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "migrate": "node --env-file-if-exists=.env src/infra/migrate-cli.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "seed:clicks": "node --env-file-if-exists=.env scripts/seed-clicks.js",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "bowser": "^2.14.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.2",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
