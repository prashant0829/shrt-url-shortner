# --- Server -------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=debug
# Public origin used to build short URLs (no trailing slash needed).
BASE_URL=http://localhost:8080
# Number of reverse proxies in front of the app (nginx, ALB, ...). 0 = none. Set it ONLY to the real
# number: the client IP is read from X-Forwarded-For counting that many entries from the right.
TRUST_PROXY_HOPS=0
# Comma-separated list of origins allowed to call the API from a browser (UI is same-origin).
CORS_ORIGINS=
# Directory with the built React app (default: server/public, where `npm run build` writes it).
# WEB_DIR=
# Comma-separated domains that cannot be shortened (subdomains are blocked too).
BLOCKED_DOMAINS=

# --- Data stores ---------------------------------------------------------
DATABASE_URL=postgres://shortener:shortener@localhost:5432/urlshortener
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# --- Security -------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-please-0123456789
JWT_TTL_SECONDS=3600
# Keyed hash so visitor IPs are never stored in clear text.
VISITOR_HASH_SECRET=dev-only-visitor-hash-secret
# Header that carries the visitor's ISO country code (set by Cloudflare / your CDN).
GEO_COUNTRY_HEADER=cf-ipcountry

# --- Caching --------------------------------------------------------------
LINK_CACHE_TTL_SECONDS=3600
LINK_NEGATIVE_CACHE_TTL_SECONDS=60

# --- Click pipeline (Redis Streams) ---------------------------------------
CLICK_STREAM_KEY=clicks
CLICK_STREAM_MAX_LEN=100000
CLICK_CONSUMER_GROUP=click-workers
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=2000
WORKER_RECLAIM_IDLE_MS=60000
# Optional: the worker touches this file after each successful poll (for container health checks).
# WORKER_HEARTBEAT_FILE=/tmp/worker.heartbeat

# --- Rate limiting (requests per minute) -----------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_CREATE_ANON_PER_MINUTE=20
RATE_LIMIT_CREATE_USER_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
